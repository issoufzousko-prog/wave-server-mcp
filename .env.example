# ==============================================================================
# Wave Server MCP — Configuration d'exemple (.env.example)
# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement
# ==============================================================================

# Port d'écoute du serveur MCP sur le smartphone Android (par défaut : 8765)
PORT_SERVEUR_MCP=8765

# Code secret Wave pour les opérations USSD (ex: 1234)
# Utilisé pour les requêtes USSD automatisées *9113*0*CODE#
WAVE_CODE_SECRET="VOTRE_CODE_PIN_WAVE"

# Adresse IP locale du smartphone (ex: 192.168.1.50)
IP_TELEPHONE="192.168.1.X"

# Adresse IP du PC (pour l'annonce automatique au démarrage)
IP_PC="192.168.1.X"
